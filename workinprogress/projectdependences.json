{
    "rulebase":[
   "rule":{
    "name":"library altest",
    "generate":{
      "filename":"libaltest.a",
      "directory":{
        "ref":"lib"
      }
    },
    "from":[
      {
        "filename":"check_test.o",
        "directory":{
          "ref":"obj"
        }
      },
      {
        "filename":"check_test.h",
        "directory":{
          "ref":"include"
        }
      }
    ],
    "using":{
      "program":"ar",
      "parameters":[
        "rccs",
        {
          "ref":"source"
        },
        {
          "ref":"destination"
        }
      ]
    },
       "when":{
	   "and":[
	       "all":{
		   "param":"a",
		   "for":"from[]",
		   "check":{
		       "file.exists":{"ref":"a.file"},
		   }
	              },
	       "one":{
		   "param":"a",
		   "for":"from[]",
		   "check":{
		       "file.older":{
		       "first":{
			   "ref":"generate.file"
		       },
		       "second":{
			   "ref":"a.file"
		       }
		       }
		   }
	       }
	   ]
       },
       "expect":{
	   "and":["one":{"file.exists":{"ref":"generate.file"}},
		  "all":{"param":"a",
			 "for":"from[]"
			 "check":{
			     "file.newer":{
				 "first":{
				 "ref":"generate.file"
				 },
				 "second":{
				     "ref":"a.file"
				 }}
			 }
			}
		 ]
       }       
   }
   ]
}
